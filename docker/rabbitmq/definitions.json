{
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "exchanges": [
    {
      "name": "ti.import",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "import-worker.import",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "import-worker.completed",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "import-worker.fail",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "vhost": "/",
      "source": "ti.import",
      "destination": "import-worker.import",
      "destination_type": "queue",
      "routing_key": "import.requested",
      "arguments": {}
    },
    {
      "vhost": "/",
      "source": "ti.import",
      "destination": "import-worker.completed",
      "destination_type": "queue",
      "routing_key": "import.completed",
      "arguments": {}
    },
    {
      "vhost": "/",
      "source": "ti.import",
      "destination": "import-worker.fail",
      "destination_type": "queue",
      "routing_key": "import.failed",
      "arguments": {}
    }
  ]
}