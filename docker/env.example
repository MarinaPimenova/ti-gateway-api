# TI Knowledge Platform - environment template for docker-compose-full.yml
# Copy to `env` (or `.env`) in this folder and fill in the REQUIRED values.
# Variables marked "optional" already have a working default inside
# docker-compose-full.yml for the all-in-Docker setup — only set them
# here if you need to override that default.

# ===================== Required: Okta authentication =====================
OKTA_DOMAIN=
OKTA_OAUTH2_CLIENT_ID=
OKTA_OAUTH2_CLIENT_SECRET=

# ===================== Required: access control =====================
# Comma-separated list of admin usernames/emails
ADMINS=

# ===================== Required: AI providers =====================
OPEN_AI_API_KEY=
OPEN_AI_ENDPOINT=
OPEN_AI_COMPLETIONS_PATH=
CHAT_MODEL=
# Only required if document ingestion uses Mistral OCR/parsing
MISTRAL_AI_API_KEY=

# ===================== Optional: Gateway =====================
APPLICATION_URL=http://localhost:8080
LOGOUT_URL=http://localhost:8080/logout
KNOWLEDGE_BASE_URL=http://localhost:5000
AI_CHATBOT_BASE_URL=http://localhost:7000
AI_QUESTION_BASE_URL=http://localhost:4000
SESSION_SSL_ENABLED=false
SESSION_CACHE_PORT=6379

# Service discovery - container names + internal ports, override only for custom topologies
KNOWLEDGE_SERVICE=ti-knowledge-api
KNOWLEDGE_SERVICE_PORT=8081
ORCHESTRATOR_SERVICE=ti-orchestrator-api
ORCHESTRATOR_SERVICE_PORT=8082
IMPORT_SERVICE=ti-import-worker
IMPORT_SERVICE_PORT=8083
EXPORT_SERVICE=ti-export-api
EXPORT_SERVICE_PORT=8084
AI_ORCHESTRATOR_SERVICE=ti-ai-orchestrator-api
AI_ORCHESTRATOR_SERVICE_PORT=8085
DOCUMENT_SERVICE=ti-document-worker
DOCUMENT_SERVICE_PORT=8086
DOCUMENT_AGENT=ti-document-agent
DOCUMENT_AGENT_PORT=8087
SQL_AGENT=ti-sql-agent
SQL_AGENT_PORT=8088

# ===================== Optional: RabbitMQ =====================
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=admin
RABBITMQ_PASS=admin

# ===================== Optional: knowledge_db (PostgreSQL) =====================
KNOWLEDGE_DB_NAME=knowledge_db
KNOWLEDGE_USER=knowledge_user
KNOWLEDGE_PASSWORD=qwerty
KNOWLEDGE_DB_URL=jdbc:postgresql://ti-knowledge-db:5432/knowledge_db

# ===================== Optional: document_db (pgvector) =====================
DOCUMENT_DB_NAME=document_db
DOCUMENT_USER=postgres
DOCUMENT_PASSWORD=postgres
DOCUMENT_DB_URL=jdbc:postgresql://ti-document-db:5432/document_db

# ===================== Optional: assistant_db (PostgreSQL) =====================
ASSISTANT_DB_NAME=assistant_db
ASSISTANT_USER=assistant_user
ASSISTANT_PASSWORD=qwerty
ASSISTANT_DB_URL=jdbc:postgresql://ti-assistant-db:5432/assistant_db

# ===================== Optional: memory-prompt Redis cache (ti-ai-orchestrator-api) =====================
MEMORY_PROMPT_REDIS_CACHE_ENABLED=false
MEMORY_PROMPT_REDIS_CACHE_HOST=memory-prompt-redis
MEMORY_PROMPT_REDIS_CACHE_PORT=6379

# ===================== Optional: embeddings & vector store (ti-document-worker) =====================
EMBEDDING_MODEL=text-embedding-ada-002
OPEN_AI_EMBEDDINGS_PATH=/openai/deployments/text-embedding-ada-002/embeddings
PGVECTOR_INDEX_TYPE=HNSW
PGVECTOR_DISTANCE_TYPE=COSINE_DISTANCE
PGVECTOR_DIMENSIONS=1024
PGVECTOR_INITIALIZE_SCHEMA=false
PGVECTOR_SCHEMA_NAME=public
PGVECTOR_TABLE_NAME=vector_store
PGVECTOR_MAX_DOCUMENT_BATCH_SIZE=10000

# ===================== Optional: shared file storage (orchestrator/import-worker/document-worker) =====================
IMPORT_STORAGE_PATH=/data/import
UPLOAD_STORAGE_PATH=/data/upload

# ===================== Optional: observability =====================
GRAFANA_ADMIN_PASS=admin
